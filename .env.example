# Copy to .env.local and fill in. Get the values with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID>
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# App Check (reCAPTCHA Enterprise score key, created with: gcloud recaptcha keys create --web --integration-type=SCORE). Without it the AI endpoint is open to anyone with the web key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Local development only: a debug token registered in Firebase console > App Check > Manage debug tokens.
# Leave empty to have the SDK print a new one in the browser console. Never commit a real value.
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=
